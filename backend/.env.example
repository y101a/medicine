POSTGRES_USER=medical_app
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=medical_assistant
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

APP_ENVIRONMENT=development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
FIELD_ENCRYPTION_KEY=replace_with_a_fernet_key
FINGERPRINT_SECRET=replace_with_at_least_32_random_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# 手机号验证与密码找回。fake 仅允许 development/test；验证码只输出到当前开发终端。
SMS_PROVIDER=fake
SMS_CODE_SECRET=replace_with_at_least_32_random_bytes
SMS_CODE_EXPIRE_SECONDS=300
SMS_TOKEN_EXPIRE_SECONDS=600
SMS_RESEND_SECONDS=60
SMS_MAX_ATTEMPTS=5
SMS_LIMIT_PHONE_HOURLY=5
SMS_LIMIT_PHONE_DAILY=10
SMS_LIMIT_IP_10M=10
SMS_LIMIT_IP_DAILY=30

# 第二阶段真实短信认证使用；RAM AccessKey 与百炼 QWEN_API_KEY 不同。
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
ALIYUN_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=

# 旧版单模型配置（迁移期兼容）
AI_API_KEY=replace_with_your_model_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=replace_with_your_model_name
AI_TIMEOUT_SECONDS=90
AVATAR_STORAGE_DIR=data/avatars

# 多模型供应商配置。真实密钥只填写在本机 .env，不要提交或粘贴到对话中。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼中国内地（北京）OpenAI 兼容地址；若控制台提供专属 API Host，请以控制台为准。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
EMBEDDING_VERSION=2026-09-01
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=1

# 应用内语音转写。ASR_API_KEY 留空时回落到 QWEN_API_KEY；不会使用用户自带模型 Key。
# 正式环境建议改为控制台提供的业务空间专属 HTTPS 地址。
ASR_API_KEY=
ASR_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash
ASR_TIMEOUT_SECONDS=45
ASR_MAX_BYTES=2097152
ASR_MAX_SECONDS=60

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 仅开发环境：缺少本地资料时搜索通用医学主题，不发送用户病情原文。
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# 仅开发环境：本地 Streamable HTTP MCP（/mcp/）。生产环境不会挂载。
MCP_ENABLED=true
EXTERNAL_TOOL_TIMEOUT_SECONDS=10

# PubMed E-utilities；API Key 可选，tool/email 用于遵守 NCBI 调用规范。
PUBMED_API_KEY=
PUBMED_TOOL_NAME=medical_assistant
PUBMED_EMAIL=

# 高德 Web 服务 Key。只允许城市/行政区编码 + 科室，不接收用户坐标或详细地址。
AMAP_API_KEY=

# 病历文档本地解析与上下文预算。原件不保存；提取文本加密保存。
ATTACHMENT_MAX_BYTES=31457280
ATTACHMENT_MAX_PAGES=100
ATTACHMENT_MAX_CHARS=500000
ATTACHMENT_CHUNK_CHARS=2000
ATTACHMENT_CONTEXT_MAX_CHARS=12000
ATTACHMENT_PARSE_TIMEOUT_SECONDS=60

# 医学图片：原图不保存；服务端规范化 WebP 后逐图加密保存 90 天。
# IMAGE_ANALYSIS_API_KEY 留空时回落到服务端 QWEN_API_KEY，绝不读取用户自带 Key。
IMAGE_ANALYSIS_API_KEY=
IMAGE_ANALYSIS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_ANALYSIS_MODEL=qwen3.8-flash
IMAGE_ANALYSIS_TIMEOUT_SECONDS=45
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=20000000
IMAGE_MAX_DIMENSION=2400
IMAGE_RETENTION_DAYS=90
IMAGE_ORPHAN_HOURS=24
IMAGE_STORAGE_DIR=data/medical_images

# AI 医学科普配图。API Key 留空时回落到服务端 QWEN_API_KEY；不使用用户自带聊天 Key。
# 推荐填写百炼业务空间原生地址（必须以 /api/v1 结尾），不要填 /compatible-mode/v1。
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1
IMAGE_GENERATION_MODEL=wan2.6-t2i
# 生产环境替换为按 GB 45438-2025 使用的服务提供者名称或正式编码。
IMAGE_GENERATION_PROVIDER_CODE=medical-assistant-local
IMAGE_GENERATION_TIMEOUT_SECONDS=30
IMAGE_GENERATION_POLL_SECONDS=3
IMAGE_GENERATION_RETENTION_DAYS=90
IMAGE_GENERATION_MAX_DOWNLOAD_BYTES=15728640
IMAGE_GENERATION_MAX_PIXELS=25000000
IMAGE_GENERATION_LIMIT_10M=3
IMAGE_GENERATION_LIMIT_DAILY=10

# AI 医学科普 DOCX/PPTX。Key 留空时回落到服务端 QWEN_API_KEY；不使用用户自带 Key。
# worker 必须由用户显式在前台启动，本项目不会注册计划任务或系统服务。
DOCUMENT_GENERATION_API_KEY=
DOCUMENT_GENERATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DOCUMENT_GENERATION_MODEL=qwen3.8-flash
DOCUMENT_GENERATION_TIMEOUT_SECONDS=60
DOCUMENT_GENERATION_RETENTION_DAYS=30
DOCUMENT_GENERATION_STORAGE_DIR=data/generated_documents
DOCUMENT_GENERATION_MAX_BYTES=10485760
DOCUMENT_GENERATION_LIMIT_10M=3
DOCUMENT_GENERATION_LIMIT_DAILY=10
DOCUMENT_GENERATION_LEASE_SECONDS=300
DOCUMENT_GENERATION_ORPHAN_HOURS=24
